  "interfaces": {
    "pre_rendered_snapshots": {
      "base_path": "data/",
      "raw_base_url": "https://raw.githubusercontent.com/psw2025-cmd/angel-fno-scanner/main/data/",
      "endpoints": [
        {
          "path": "data/summary.md",
          "type": "markdown",
          "description": "Markdown summary of Top Gap-Ups, CE Breakouts, and PE Breakdowns"
        },
        {
          "path": "data/top_gapup.json",
          "type": "json",
          "description": "Top 20 predicted 9:15 AM pre-market gap-up winners"
        },
        {
          "path": "data/breakouts.json",
          "type": "json",
          "description": "Top Call (CE) breakouts and Put (PE) breakdowns with win probability"
        },
        {
          "path": "data/latest_predictions.json",
          "type": "json",
          "description": "Complete 216-symbol option chain predictions and Greeks"
        },
        {
          "path": "data/market_news.json",
          "type": "json",
          "description": "Multi-source news feed with tone score and catalyst classification"
        },
        {
          "path": "data/system_health.json",
          "type": "json",
          "description": "Forensic audit status across Sheets, BigQuery, and Calibration engine"
        }
      ]
    },
    "issue_ops": {
      "workflow": ".github/workflows/agent_issue_ops.yml",
      "trigger": "Issue or PR comment starting with '/'",
      "commands": [
        {
          "command": "/predict",
          "params": "<SYMBOL>",
          "description": "Returns full Black-76 Greeks, probabilities, and news impact for an F&O stock"
        },
        {
          "command": "/gapup",
          "params": "[LIMIT]",
          "description": "Ranks top predicted 9:15 AM pre-market gap-up winners by conviction"
        },
        {
          "command": "/breakouts",
          "params": "[LIMIT]",
          "description": "Ranks top CE breakouts and PE breakdowns by win probability"
        },
        {
          "command": "/news",
          "params": "<SYMBOL> [LIMIT]",
          "description": "Queries live news headlines, tone, and catalysts for a symbol"
        },
        {
          "command": "/verify",
          "params": "None",
          "description": "Executes full forensic audit of 17 Sheet tabs, BigQuery, and state"
        },
        {
          "command": "/run-cycle",
          "params": "None",
          "description": "Triggers immediate live prediction & calibration cycle"
        },
        {
          "command": "/snapshots",
          "params": "None",
          "description": "Refreshes and renders latest market intelligence summary"
        },
        {
          "command": "/help",
          "params": "None",
          "description": "Displays help menu with available commands"
        }
      ]
    },
    "actions_dispatch": {
      "workflow": ".github/workflows/agent_dispatch.yml",
      "supported_events": [
        "workflow_dispatch",
        "repository_dispatch"
      ],
      "repository_dispatch_event_type": "agent_action",
      "actions": [
        "top_gapup",
        "top_breakouts",
        "predict",
        "query_news",
        "run_cycle",
        "verify",
        "export_snapshots"
      ]
    },
    "cli_sdk": {
      "entrypoint": "agent_cli.py",
      "flags": [
        {
          "flag": "--predict",
          "type": "string",
          "description": "Predict option performance and Greeks for symbol"
        },
        {
          "flag": "--top-gapup",
          "type": "boolean",
          "description": "List top predicted pre-market gap-up candidates"
        },
        {
          "flag": "--top-breakouts",
          "type": "boolean",
          "description": "List top CE breakouts and PE breakdowns"
        },
        {
          "flag": "--query-news",
          "type": "boolean",
          "description": "Query news sentiment for symbol"
        },
        {
          "flag": "--verify",
          "type": "boolean",
          "description": "Run forensic verification of all 17 tabs and BigQuery"
        },
        {
          "flag": "--run-cycle",
          "type": "boolean",
          "description": "Execute one live prediction pipeline cycle"
        },
        {
          "flag": "--export-snapshots",
          "type": "boolean",
          "description": "Export fresh data snapshots to data/"
        },
        {
          "flag": "--format",
          "type": "choice",
          "choices": [
            "json",
            "markdown"
          ],
          "default": "json"
        }
      ]
    }
  },
  "bigquery_tables": [
    {
      "table_id": "option_predictions_live",
      "row_count": 216,
      "columns_count": 48,
      "description": "Primary real-time option predictions, Black-76 Greeks, gap forecasts, and conviction scores"
    },
    {
      "table_id": "market_news_sentiment",
      "columns_count": 21,
      "description": "Deduplicated multi-source news knowledge graph with Bayesian tone scores"
    },
    {
      "table_id": "prediction_calibration_log",
      "columns_count": 11,
      "description": "Weight calibration history tracking hit rate (100%), recall @ 10, and mean rank"
    }
  ],
  "google_sheet_tabs": [
    "PRE_BREAKOUT_SCANNER",
    "Sheet1",
