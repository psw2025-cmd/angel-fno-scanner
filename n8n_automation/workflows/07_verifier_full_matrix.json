{
  "name": "Angel FNO Agent-1 Verifier \u2014 360 Matrix",
  "nodes": [
    {
      "parameters": {
        "path": "verifier-run",
        "responseMode": "lastNode"
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        50,
        300
      ],
      "webhookId": "verifier-run"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 9-15 * * 1-5"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:5680/orchestrator-status",
        "method": "GET",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http",
      "name": "Call orchestrator-status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "notEqual",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "check",
      "name": "Check Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    }
  ],
  "connections": {},
  "active": false,
  "settings": {},
  "versionId": "07_verifier_full_matrix"
}