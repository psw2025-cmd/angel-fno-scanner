{
  "id": "angel-fno-bigquery-schema-lineage-guardian",
  "name": "Angel FNO BigQuery Schema, Lineage & Freshness Guardian",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "bq-sched",
      "name": "Every 15m BQ Audit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -500,
        200
      ]
    },
    {
      "parameters": {
        "path": "bigquery-audit",
        "httpMethod": "GET",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "bq-webhook",
      "name": "Webhook: BQ Audit",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -500,
        400
      ],
      "webhookId": "bigquery-audit-webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5680/bigquery",
        "options": {
          "timeout": 45000
        }
      },
      "id": "bq-http",
      "name": "Inspect BigQuery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const d=$input.first().json;\nconst now=new Date(); const ist=new Date(now.toLocaleString(\"en-US\",{timeZone:\"Asia/Kolkata\"}));\nconst wd=ist.getDay(); const mins=ist.getHours()*60+ist.getMinutes(); const market=wd>=1&&wd<=5&&mins>=555&&mins<=930;\nconst lineage=[\"with_runid\",\"with_sha\",\"with_writer\",\"with_cycle\",\"with_source_ts\"].every(k=>Number(d[k])===219)\n && [\"run_ids\",\"git_shas\",\"writer_ids\",\"cycle_ids\"].every(k=>Number(d[k])===1);\nconst universe=Number(d.total_rows)===219 && Number(d.unique_symbols)===219;\nconst fresh=!market || (typeof d.source_age_seconds===\"number\" && d.source_age_seconds<=1200);\nconst ok=universe&&lineage&&fresh;\nreturn [{json:{status:ok?\"PASS\":\"FAIL\",total_rows:d.total_rows,unique_symbols:d.unique_symbols,\nsource_age_seconds:d.source_age_seconds,lineage_complete:lineage,fresh_during_market:fresh,\nverdict:ok?\"SCHEMA_LINEAGE_FRESHNESS_PASS\":\"BQ_GATE_FAILED\",read_only:true}}];"
      },
      "id": "bq-eval",
      "name": "Validate BigQuery Lineage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    }
  ],
  "connections": {
    "Every 15m BQ Audit": {
      "main": [
        [
          {
            "node": "Inspect BigQuery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook: BQ Audit": {
      "main": [
        [
          {
            "node": "Inspect BigQuery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Inspect BigQuery": {
      "main": [
        [
          {
            "node": "Validate BigQuery Lineage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "availableInMCP": true,
    "binaryMode": "separate"
  }
}
