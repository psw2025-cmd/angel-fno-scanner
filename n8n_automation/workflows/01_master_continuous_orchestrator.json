{
  "id": "angel-fno-master-orchestrator",
  "name": "Angel FNO Master Continuous Orchestrator \u2014 Fail Closed",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 9-15 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "*/15 0-8,16-23 * * *"
            }
          ]
        }
      },
      "id": "master-sched",
      "name": "Every 5m Market / 15m Off-Peak",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -600,
        100
      ]
    },
    {
      "parameters": {
        "path": "orchestrator-run",
        "httpMethod": "GET",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "master-webhook",
      "name": "Webhook: Orchestrator Run",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ],
      "webhookId": "orchestrator-run-webhook"
    },
    {
      "parameters": {},
      "id": "master-exec",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -600,
        500
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5680/orchestrator-status",
        "options": {
          "timeout": 120000
        }
      },
      "id": "master-status",
      "name": "Fetch Verified Orchestrator Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "healthy",
              "leftValue": "={{ $json.orchestrator_verdict }}",
              "rightValue": "HEALTHY",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "master-if",
      "name": "If Verified HEALTHY",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const d=$input.first().json;\nreturn [{json:{status:\"HEALTHY\",timestamp_ist:d.timestamp_ist,market_open:d.market_open,\nchecks:d.checks,read_only:true,message:\"All required live checks passed.\"}}];"
      },
      "id": "master-ok",
      "name": "Log Verified Heartbeat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        180
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5680/diagnose",
        "options": {
          "timeout": 120000
        }
      },
      "id": "master-diagnose",
      "name": "Diagnose Failure \u2014 Read Only",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        420
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5680/verification-harness",
        "options": {
          "timeout": 180000
        }
      },
      "id": "master-reverify",
      "name": "Independent Re-Verify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        420
      ]
    }
  ],
  "connections": {
    "Every 5m Market / 15m Off-Peak": {
      "main": [
        [
          {
            "node": "Fetch Verified Orchestrator Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook: Orchestrator Run": {
      "main": [
        [
          {
            "node": "Fetch Verified Orchestrator Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Fetch Verified Orchestrator Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Verified Orchestrator Status": {
      "main": [
        [
          {
            "node": "If Verified HEALTHY",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Verified HEALTHY": {
      "main": [
        [
          {
            "node": "Log Verified Heartbeat",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Diagnose Failure \u2014 Read Only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Diagnose Failure \u2014 Read Only": {
      "main": [
        [
          {
            "node": "Independent Re-Verify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "availableInMCP": true,
    "binaryMode": "separate"
  }
}
