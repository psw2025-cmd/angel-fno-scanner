{
  "id": "angel-fno-operator-snapshot-archiver",
  "name": "Angel FNO Daily Operator Evidence Snapshot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "15 16 * * 1-5"
            }
          ]
        }
      },
      "id": "archive-sched",
      "name": "Daily Post-Market 16:15 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -500,
        200
      ]
    },
    {
      "parameters": {
        "path": "archive-snapshot",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "archive-webhook",
      "name": "Webhook: Archive Snapshot",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -500,
        400
      ],
      "webhookId": "archive-snapshot-webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5680/post-market",
        "options": {
          "timeout": 120000
        }
      },
      "id": "archive-http",
      "name": "Run Post-Market Evidence Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const d=$input.first().json;\nconst ok=d.status===\"success\" && Number(d.returncode)===0;\nreturn [{json:{status:ok?\"EVIDENCE_CAPTURED\":\"SNAPSHOT_FAILED\",timestamp_ist:new Date().toLocaleString(\"en-IN\",{timeZone:\"Asia/Kolkata\"}),\nevidence:d.evidence||null,read_only:true,note:\"No performance or forecast-verification claim is made by this node.\"}}];"
      },
      "id": "archive-eval",
      "name": "Record Snapshot Evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    }
  ],
  "connections": {
    "Daily Post-Market 16:15 IST": {
      "main": [
        [
          {
            "node": "Run Post-Market Evidence Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook: Archive Snapshot": {
      "main": [
        [
          {
            "node": "Run Post-Market Evidence Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Post-Market Evidence Snapshot": {
      "main": [
        [
          {
            "node": "Record Snapshot Evidence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "availableInMCP": true,
    "binaryMode": "separate"
  }
}
