{
  "id": "angel-fno-failure-handler-and-remediation",
  "name": "Angel FNO Failure Handler & Diagnosis \u2014 No Writes",
  "nodes": [
    {
      "parameters": {
        "path": "diagnose-failure",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "fail-webhook",
      "name": "Webhook: Diagnose Failure",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -500,
        200
      ],
      "webhookId": "diagnose-failure-webhook"
    },
    {
      "parameters": {},
      "id": "fail-exec",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -500,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5680/diagnose",
        "options": {
          "timeout": 120000
        }
      },
      "id": "fail-diagnose",
      "name": "Collect Diagnosis \u2014 No Writes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:5680/verification-harness",
        "options": {
          "timeout": 180000
        }
      },
      "id": "fail-harness",
      "name": "Run Verification Harness",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const h=$input.first().json;\nconst passed=Number(h.checks_passed||0); const total=Number(h.checks_total||0);\nconst exact=total>0 && passed===total && h.verdict===\"PASS\";\nreturn [{json:{status:exact?\"PASS_AFTER_RECHECK\":\"FAIL_CLOSED_ALERT\",checks_passed:passed,\nchecks_total:total,harness_verdict:h.verdict||\"UNKNOWN\",read_only:true,\nrecommended_action:exact?\"No mutation required.\":\"Controlled repair branch required; do not modify production data automatically.\"}}];"
      },
      "id": "fail-eval",
      "name": "Evaluate Without Auto-Mutation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    }
  ],
  "connections": {
    "Webhook: Diagnose Failure": {
      "main": [
        [
          {
            "node": "Collect Diagnosis \u2014 No Writes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Collect Diagnosis \u2014 No Writes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Diagnosis \u2014 No Writes": {
      "main": [
        [
          {
            "node": "Run Verification Harness",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Verification Harness": {
      "main": [
        [
          {
            "node": "Evaluate Without Auto-Mutation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "availableInMCP": true,
    "binaryMode": "separate"
  }
}
