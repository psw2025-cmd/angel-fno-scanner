{
  "name": "Angel FNO Agent-3 Learner \u2014 Nightly Weights",
  "nodes": [
    {
      "parameters": {
        "path": "learner-run",
        "responseMode": "lastNode"
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        50,
        300
      ],
      "webhookId": "learner-run"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 23 * * *"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:5680/runtime-evidence",
        "method": "GET",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http",
      "name": "Call runtime-evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "notEqual",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "check",
      "name": "Check Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    }
  ],
  "connections": {},
  "active": false,
  "settings": {},
  "versionId": "09_learner_nightly"
}