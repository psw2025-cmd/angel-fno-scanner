[
  {
    "id": "angel-fno-read-only-monitor",
    "name": "Angel FNO Read-Only Session Monitor",
    "active": true,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "55 8 * * 1-5"
              },
              {
                "field": "cronExpression",
                "expression": "0,5,10 9 * * 1-5"
