  {
    "id": "angel-fno-sandbox-runner",
    "name": "Angel FNO Local Sandbox Python Runner",
    "active": true,
    "nodes": [
      {
        "parameters": {},
        "id": "trigger-sandbox-1",
        "name": "CLI Validation Trigger",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1,
        "position": [
          -200,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://127.0.0.1:8080/sandboxes/cc9406c7-65c7-5c0e-b4c7-20573a7a59cf/executions",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-API-Key",
                "value": "angel-local-sandbox-key"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ command: 'python3 -c \"' + ($json.code ? $json.code.replace(/\"/g, '\\\\\"') : 'print(5050)') + '\"' }) }}"
        },
        "id": "exec-sandbox-1",
        "name": "Execute in Sandbox",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          100,
          0
        ]
      }
    ],
    "connections": {
      "CLI Validation Trigger": {
        "main": [
          [
            {
              "node": "Execute in Sandbox",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "timezone": "Asia/Kolkata",
      "executionOrder": "v1",
      "saveDataSuccessExecution": "all",
      "saveDataErrorExecution": "all",
      "saveManualExecutions": true,
      "availableInMCP": true
    }
  },
