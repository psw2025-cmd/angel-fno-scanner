table MarketCalendar
	lineageTag: t0000000-0000-0000-0000-000000000011

	column session_date
		dataType: string
		lineageTag: c1000000-0000-0000-0000-000000000001
		summarizeBy: none
		sourceColumn: session_date

	column day_status
		dataType: string
		lineageTag: c1000000-0000-0000-0000-000000000002
		summarizeBy: none
		sourceColumn: day_status

	column name
		dataType: string
		lineageTag: c1000000-0000-0000-0000-000000000003
		summarizeBy: none
		sourceColumn: name

	column open_start_minute
		dataType: int64
		formatString: 0
		lineageTag: c1000000-0000-0000-0000-000000000004
		summarizeBy: min
		sourceColumn: open_start_minute

	column open_score_end_minute
		dataType: int64
		formatString: 0
		lineageTag: c1000000-0000-0000-0000-000000000005
		summarizeBy: min
		sourceColumn: open_score_end_minute

	column pre_close_start_minute
		dataType: int64
		formatString: 0
		lineageTag: c1000000-0000-0000-0000-000000000006
		summarizeBy: min
