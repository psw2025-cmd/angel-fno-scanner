	column snapshot_time_ist_corrected
		dataType: dateTime
		formatString: General Date
		lineageTag: c0000000-0000-0000-0000-000000000028
		summarizeBy: none
		sourceColumn: snapshot_time_ist_corrected

		variation Variation
			isDefault
			relationship: 071a9b4c-1cd2-4ded-952d-ef0bc17755da
			defaultHierarchy: LocalDateTable_2d59eba7-2d6e-4bb7-aff5-d75e0575aee5.'Date Hierarchy'

	column model_side
		dataType: string
		lineageTag: c0000000-0000-0000-0000-000000000029
		summarizeBy: none
		sourceColumn: model_side

	column probability_sum
		dataType: double
		formatString: 0.00
		lineageTag: c0000000-0000-0000-0000-000000000030
		summarizeBy: sum
		sourceColumn: probability_sum

		annotation SummarizationSetBy = Automatic

	column probability_valid
		dataType: boolean
