		dataType: string
		lineageTag: c0000000-0000-0000-0000-000000000032
		summarizeBy: none
		sourceColumn: liquidity_status

	column forecast_window
		dataType: string
		lineageTag: c0000000-0000-0000-0000-000000000033
		summarizeBy: none
		sourceColumn: forecast_window

	partition OptionPredictions = m
		mode: import
		source =
				let
				    Url = "https://raw.githubusercontent.com/psw2025-cmd/angel-fno-scanner/main/data/latest_predictions.json",
				    RawBytes = try Web.Contents(Url) otherwise null,
				    RawJson = if RawBytes <> null then Json.Document(RawBytes) else {},
				    Raw = Table.FromRecords(RawJson),
				    FixSnapshot = Table.AddColumn(
				        Raw,
				        "snapshot_time_ist_corrected",
				        each
				            let
				                T = try Text.From([snapshot_timestamp]) otherwise null,
				                Wall = if T = null then null else Text.Start(T, 19),
				                WallDT = try DateTime.FromText(Wall) otherwise null,
				                RawZone = try DateTimeZone.FromText(T) otherwise null
				            in
				                if T = null then null
				                else if pTreatSnapshotOffsetAsWallClock and WallDT <> null
				                    then DateTimeZone.RemoveZone(DateTime.AddZone(WallDT, 5, 30))
				                    else if RawZone <> null
				                        then DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(RawZone, 5, 30))
				                        else null,
				        type datetime
				    ),
				    AddSide = Table.AddColumn(
				        FixSnapshot,
				        "model_side",
				        each
				            let
				                ce = try Number.From([ce_win_prob]) otherwise 0,
				                pe = try Number.From([pe_win_prob]) otherwise 0
				            in
				                if ce > pe then "CE"
				                else if pe > ce then "PE"
				                else "NEUTRAL",
				        type text
				    ),
				    AddProbabilitySum = Table.AddColumn(
				        AddSide,
				        "probability_sum",
				        each try Number.From([ce_win_prob]) + Number.From([pe_win_prob]) otherwise null,
				        type number
				    ),
				    AddProbabilityValid = Table.AddColumn(
				        AddProbabilitySum,
				        "probability_valid",
				        each if [probability_sum] = null then false else Number.Abs([probability_sum] - 100) <= 0.25,
				        type logical
				    ),
				    AddLiquidity = Table.AddColumn(
				        AddProbabilityValid,
				        "liquidity_status",
				        each
				            let
				                ceoi = try Number.From([ce_oi]) otherwise 0,
				                peoi = try Number.From([pe_oi]) otherwise 0,
				                cel = try Number.From([ce_ltp]) otherwise 0,
				                pel = try Number.From([pe_ltp]) otherwise 0,
				                ces = try Number.From([ce_bid_ask_spread]) otherwise null,
				                pes = try Number.From([pe_bid_ask_spread]) otherwise null
				            in
				                if ceoi <= 0 or peoi <= 0 or cel <= 0 or pel <= 0 then "REJECT"
				                else if (ces <> null and ces > cel * 0.25) or (pes <> null and pes > pel * 0.25) then "REJECT"
				                else "PASS",
				        type text
				    ),
				    AddForecastWindow = Table.AddColumn(
				        AddLiquidity,
				        "forecast_window",
				        each
				            let
				                z = [snapshot_time_ist_corrected],
				                h = if z = null then null else Time.Hour(z)
				            in
				                if h = null then "UNKNOWN"
				                else if h >= 15 or h < 9 then "NEXT_SESSION_ELIGIBLE"
				                else "INTRADAY_SNAPSHOT",
				        type text
				    ),
				    KeepCols = Table.SelectColumns(
				        AddForecastWindow,
				        {
				            "symbol", "ce_win_prob", "pe_win_prob", "confidence_pct", "intensity_score",
				            "expected_gap_pct", "gap_direction", "pre_open_conviction_pct", "target_open_strike",
				            "ce_chg_pct", "pe_chg_pct", "ce_oi", "pe_oi", "ce_ltp", "pe_ltp",
				            "ce_bid_ask_spread", "pe_bid_ask_spread", "atm_pcr", "ce_iv", "pe_iv",
				            "ce_delta", "pe_delta", "ce_gamma", "pe_gamma", "top_news_headline",
				            "news_severity_level", "snapshot_timestamp", "snapshot_time_ist_corrected",
				            "model_side", "probability_sum", "probability_valid", "liquidity_status",
				            "forecast_window"
				        },
				        MissingField.UseNull
				    ),
				    Types = Table.TransformColumnTypes(
				        KeepCols,
				        {
				            {"symbol", type text},
				            {"ce_win_prob", type number},
				            {"pe_win_prob", type number},
				            {"confidence_pct", type number},
				            {"intensity_score", type number},
				            {"expected_gap_pct", type number},
				            {"gap_direction", type text},
				            {"pre_open_conviction_pct", type number},
				            {"target_open_strike", type text},
				            {"ce_chg_pct", type number},
				            {"pe_chg_pct", type number},
				            {"ce_oi", Int64.Type},
				            {"pe_oi", Int64.Type},
				            {"ce_ltp", type number},
				            {"pe_ltp", type number},
				            {"ce_bid_ask_spread", type number},
				            {"pe_bid_ask_spread", type number},
				            {"atm_pcr", type number},
				            {"ce_iv", type number},
				            {"pe_iv", type number},
				            {"ce_delta", type number},
				            {"pe_delta", type number},
				            {"ce_gamma", type number},
				            {"pe_gamma", type number},
				            {"top_news_headline", type text},
				            {"news_severity_level", Int64.Type},
				            {"snapshot_timestamp", type text},
				            {"snapshot_time_ist_corrected", type datetime},
				            {"model_side", type text},
				            {"probability_sum", type number},
				            {"probability_valid", type logical},
				            {"liquidity_status", type text},
				            {"forecast_window", type text}
				        },
				        "en-US"
				    )
				in
				    Types

